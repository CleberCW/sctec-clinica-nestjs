# PostgreSQL local (Docker Compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=clinica
POSTGRES_PORT=5432

# Configuração da API
# Local: DB_HOST=localhost
# Produção: DB_HOST=10.0.0.23
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_NAME=clinica

# Gere valores exclusivos com: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
JWT_ISSUER=sctec-clinica

# Administrador inicial criado pelo AdminSeedService
INITIAL_ADMIN_EMAIL=admin@medclinic.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
